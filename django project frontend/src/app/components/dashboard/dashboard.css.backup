/* ══════════════════════════════════════
   MODERN STREAMING PLATFORM STYLES
══════════════════════════════════════ */

.streaming-app {
  min-height: 100vh;
  background-color: #141414;
  color: #e5e5e5;
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

/* ══════ TOP NAVIGATION ══════ */
.top-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 68px;
  background: linear-gradient(180deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.7) 70%, transparent 100%);
  backdrop-filter: blur(10px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4%;
  z-index: 999;
  transition: background 0.3s ease;
}

.top-nav.scrolled {
  background: rgba(20, 20, 20, 0.98);
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 40px;
}

.logo-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 24px;
  font-weight: 800;
  color: #e50914;
  user-select: none;
}

.brand-icon {
  font-size: 28px;
}

.brand-name {
  background: linear-gradient(135deg, #e50914, #ff6b00);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  font-weight: 900;
  letter-spacing: -0.5px;
}

.nav-links {
  display: flex;
  gap: 24px;
  align-items: center;
}

.nav-link {
  background: none;
  border: none;
  color: #e5e5e5;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  padding: 8px 0;
  transition: color 0.2s ease;
  position: relative;
}

.nav-link:hover {
  color: #fff;
}

.nav-link.active {
  color: #fff;
  font-weight: 700;
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 3px;
  background: #e50914;
  border-radius: 2px 2px 0 0;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 24px;
}

.search-container {
  position: relative;
}

.search-nav-input {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 4px;
  padding: 8px 36px 8px 12px;
  color: #fff;
  font-size: 13px;
  width: 250px;
  outline: none;
  transition: all 0.2s ease;
}

.search-nav-input:focus {
  background: rgba(255, 255, 255, 0.15);
  border-color: #e50914;
  width: 300px;
}

.search-nav-input::placeholder {
  color: rgba(255, 255, 255, 0.6);
}

.search-nav-icon {
  position: absolute;
  right: 12px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 14px;
  opacity: 0.7;
  pointer-events: none;
}

.user-profile {
  display: flex;
  align-items: center;
  gap: 16px;
}

.username {
  font-size: 13px;
  font-weight: 500;
  color: #e5e5e5;
}

.btn-logout-nav {
  background: none;
  border: 1px solid rgba(255, 255, 255, 0.3);
  color: #e5e5e5;
  padding: 6px 16px;
  border-radius: 4px;
  font-size: 13px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-logout-nav:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: #e50914;
  color: #fff;
}

/* ══════ HERO SECTION ══════ */
.hero-section {
  position: relative;
  height: 85vh;
  min-height: 600px;
  display: flex;
  align-items: center;
  padding: 0 4%;
  margin-top: 0;
  overflow: hidden;
}

.hero-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  filter: brightness(0.4);
}

.hero-gradient {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to right,
    rgba(20, 20, 20, 0.95) 0%,
    rgba(20, 20, 20, 0.7) 40%,
    transparent 80%
  ),
  linear-gradient(
    to top,
    rgba(20, 20, 20, 1) 0%,
    transparent 40%
  );
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 600px;
  padding: 40px 0;
}

.hero-badges {
  display: flex;
  gap: 12px;
  margin-bottom: 16px;
}

.hero-badge {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  padding: 4px 14px;
  border-radius: 4px;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 1px;
  color: #fff;
}

.hero-title {
  font-size: 56px;
  font-weight: 900;
  line-height: 1.1;
  margin: 0 0 20px 0;
  color: #fff;
  text-shadow: 2px 4px 12px rgba(0, 0, 0, 0.8);
}

.hero-description {
  font-size: 16px;
  line-height: 1.6;
  margin: 0 0 16px 0;
  color: #e5e5e5;
  text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.8);
}

.hero-meta {
  margin-bottom: 24px;
}

.hero-genres {
  font-size: 14px;
  color: #e50914;
  font-weight: 600;
}

.hero-actions {
  display: flex;
  gap: 16px;
}

.btn-hero-play {
  background: #fff;
  border: none;
  color: #000;
  padding: 14px 32px;
  border-radius: 4px;
  font-size: 16px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 8px;
  transition: all 0.2s ease;
}

.btn-hero-play:hover {
  background: rgba(255, 255, 255, 0.9);
  transform: scale(1.05);
}

.btn-hero-favorite {
  background: rgba(109, 109, 110, 0.7);
  backdrop-filter: blur(10px);
  border: none;
  color: #fff;
  padding: 14px 28px;
  border-radius: 4px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-hero-favorite:hover {
  background: rgba(109, 109, 110, 0.9);
}

.btn-hero-favorite.favorited {
  background: rgba(229, 9, 20, 0.8);
}

/* ══════ MAIN CONTENT ══════ */
.main-content {
  padding: 40px 4%;
  background-color: #141414;
  min-height: 100vh;
}

.main-content.has-hero {
  padding-top: 0;
  margin-top: -100px;
  position: relative;
  z-index: 3;
}

.user-content {
  margin-top: 68px;
  padding: 40px 0;
}

/* ══════ FILTERS BAR ══════ */
.filters-bar {
  display: flex;
  gap: 16px;
  margin-bottom: 32px;
  padding: 16px 0;
}

.filter-select-user {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #fff;
  padding: 10px 16px;
  border-radius: 4px;
  font-size: 14px;
  cursor: pointer;
  outline: none;
  transition: all 0.2s ease;
}

.filter-select-user:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: #e50914;
}

.filter-select-user option {
  background: #2f2f2f;
  color: #fff;
}

/* ══════ SECTION HEADER ══════ */
.section-header {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.section-title {
  font-size: 24px;
  font-weight: 700;
  color: #e5e5e5;
  margin: 0;
}

.section-count {
  font-size: 14px;
  color: #808080;
  font-weight: 500;
}

/* ══════ MOVIES GRID (User View) ══════ */
.movies-grid-user {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 24px;
  margin-bottom: 48px;
}

@media (max-width: 1400px) {
  .movies-grid-user {
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 20px;
  }
}

@media (max-width: 768px) {
  .movies-grid-user {
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 16px;
  }
}

.movie-card-user {
  position: relative;
  cursor: pointer;
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  border-radius: 6px;
  overflow: hidden;
  background: #2f2f2f;
}

.movie-card-user:hover {
  transform: scale(1.08);
  z-index: 10;
  box-shadow: 0 8px 30px rgba(0, 0, 0, 0.7);
}

.poster-container-user {
  position: relative;
  width: 100%;
  padding-top: 150%;
  overflow: hidden;
  background: #1a1a1a;
}

.poster-img-user {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: all 0.3s ease;
}

.movie-card-user:hover .poster-img-user {
  filter: brightness(0.7);
}

.poster-overlay-user {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    to bottom,
    rgba(0, 0, 0, 0.4) 0%,
    transparent 30%,
    transparent 70%,
    rgba(0, 0, 0, 0.8) 100%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 12px;
}

.movie-card-user:hover .poster-overlay-user {
  opacity: 1;
}

.overlay-top {
  display: flex;
  justify-content: flex-end;
}

.overlay-bottom {
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn-favorite-icon {
  background: rgba(0, 0, 0, 0.7);
  backdrop-filter: blur(5px);
  border: 2px solid rgba(255, 255, 255, 0.3);
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-favorite-icon:hover {
  background: rgba(0, 0, 0, 0.9);
  border-color: #e50914;
  transform: scale(1.1);
}

.btn-favorite-icon.favorited {
  background: rgba(229, 9, 20, 0.9);
  border-color: #e50914;
}

.btn-play-icon {
  background: rgba(255, 255, 255, 0.9);
  border: none;
  width: 48px;
  height: 48px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #000;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-play-icon:hover {
  background: #fff;
  transform: scale(1.15);
}

.movie-info-user {
  padding: 12px;
  background: #2f2f2f;
}

.movie-title-user {
  font-size: 15px;
  font-weight: 600;
  color: #e5e5e5;
  margin: 0 0 8px 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  line-height: 1.3;
}

.movie-meta-user {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  color: #808080;
  margin-bottom: 6px;
}

.meta-separator {
  color: #606060;
}

.movie-year-user,
.movie-type-user {
  font-weight: 500;
}

.movie-genres-user {
  font-size: 11px;
  color: #e50914;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ══════ PAGINATION ══════ */
.pagination-user {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16px;
  padding: 40px 0;
}

.btn-page-user {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #e5e5e5;
  padding: 10px 20px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-page-user:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.15);
  border-color: #e50914;
  color: #fff;
}

.btn-page-user:disabled {
  opacity: 0.3;
  cursor: not-allowed;
}

.page-numbers {
  display: flex;
  gap: 8px;
}

.btn-page-number {
  background: rgba(255, 255, 255, 0.1);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #e5e5e5;
  width: 40px;
  height: 40px;
  border-radius: 4px;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-page-number:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: #e50914;
  color: #fff;
}

.btn-page-number.active {
  background: #e50914;
  border-color: #e50914;
  color: #fff;
  font-weight: 700;
}

/* ══════ LOADING & EMPTY STATES ══════ */
.spinner-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100px 20px;
  color: #808080;
}

.spinner {
  width: 50px;
  height: 50px;
  border: 4px solid rgba(229, 9, 20, 0.1);
  border-top-color: #e50914;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.empty-state-user {
  text-align: center;
  padding: 100px 20px;
  color: #808080;
}

.empty-icon {
  font-size: 64px;
  margin-bottom: 16px;
}

.empty-state-user h3 {
  font-size: 24px;
  font-weight: 700;
  color: #e5e5e5;
  margin: 0 0 8px 0;
}

.empty-state-user p {
  font-size: 16px;
  margin: 0;
}

/* ══════ TOASTS ══════ */
.toast {
  position: fixed;
  top: 80px;
  right: 4%;
  z-index: 9999;
  padding: 16px 24px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 12px;
  cursor: pointer;
  animation: slideIn 0.3s ease;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
}

@keyframes slideIn {
  from {
    transform: translateX(400px);
    opacity: 0;
  }
  to {
    transform: translateX(0);
    opacity: 1;
  }
}

.toast.success {
  background: rgba(0, 128, 0, 0.95);
  border: 1px solid rgba(0, 255, 0, 0.3);
  color: #fff;
}

.toast.error {
  background: rgba(229, 9, 20, 0.95);
  border: 1px solid rgba(255, 0, 0, 0.3);
  color: #fff;
}

.toast .close {
  font-size: 18px;
  font-weight: bold;
  margin-left: auto;
}

/* ══════ MOVIE DETAIL MODAL ══════ */
.detail-modal-user {
  background: #181818;
  border: none;
  border-radius: 8px;
  max-width: 950px;
  width: 95%;
  max-height: 90vh;
  overflow-y: auto;
}

.modal-close {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  color: #fff;
  font-size: 20px;
  cursor: pointer;
  transition: all 0.2s ease;
}

.modal-close:hover {
  background: rgba(255, 255, 255, 0.2);
}

.detail-container {
  display: grid;
  grid-template-columns: 300px 1fr;
  gap: 40px;
  padding: 40px;
}

@media (max-width: 768px) {
  .detail-container {
    grid-template-columns: 1fr;
    gap: 24px;
    padding: 24px;
  }
}

.detail-poster-section {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.detail-poster {
  width: 100%;
  border-radius: 8px;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
}

.btn-favorite-large {
  background: rgba(255, 255, 255, 0.1);
  border: 2px solid rgba(255, 255, 255, 0.3);
  color: #fff;
  padding: 14px;
  border-radius: 6px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
}

.btn-favorite-large:hover {
  background: rgba(255, 255, 255, 0.15);
  border-color: #e50914;
}

.btn-favorite-large.favorited {
  background: rgba(229, 9, 20, 0.2);
  border-color: #e50914;
  color: #e50914;
}

.detail-info-section {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.detail-title {
  font-size: 36px;
  font-weight: 800;
  color: #fff;
  margin: 0;
  line-height: 1.2;
}

.detail-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20px;
  font-size: 14px;
}

.meta-item strong {
  color: #808080;
  font-weight: 600;
  margin-right: 6px;
}

.detail-section {
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  padding-top: 16px;
}

.detail-section h3 {
  font-size: 16px;
  font-weight: 700;
  color: #fff;
  text-transform: uppercase;
  letter-spacing: 1px;
  margin: 0 0 12px 0;
}

.detail-section p {
  font-size: 15px;
  line-height: 1.6;
  color: #b3b3b3;
  margin: 0;
}

.description-text {
  font-size: 16px !important;
  line-height: 1.7 !important;
}

/* ══════ RESPONSIVE ══════ */
@media (max-width: 1024px) {
  .hero-title {
    font-size: 42px;
  }
  
  .hero-content {
    max-width: 500px;
  }
}

@media (max-width: 768px) {
  .nav-links {
    gap: 16px;
  }
  
  .nav-link {
    font-size: 13px;
  }
  
  .search-nav-input {
    width: 180px;
  }
  
  .search-nav-input:focus {
    width: 220px;
  }
  
  .hero-section {
    height: 70vh;
    min-height: 500px;
  }
  
  .hero-title {
    font-size: 32px;
  }
  
  .hero-description {
    font-size: 14px;
  }
  
  .hero-actions {
    flex-direction: column;
  }
  
  .btn-hero-play,
  .btn-hero-favorite {
    width: 100%;
    justify-content: center;
  }
}

/* ══════ ADMIN MODE (Keep original styles) ══════ */
.streaming-app.admin-mode .main-content {
  background-color: #08080c;
  margin-top: 0;
  padding: 30px 40px;
}

/* Keep all original admin styles */
.admin-mode .header,
.admin-mode .dashboard-grid,
.admin-mode .card,
.admin-mode .filter-toolbar {
  /* Original admin styles are preserved */
}
